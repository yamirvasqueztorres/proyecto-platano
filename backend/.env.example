# Configuración para PostgreSQL instalado en este equipo.
# Copiar a backend/.env. Este archivo prevalece sobre el .env de la raíz.
# Las variables del proceso prevalecen sobre ambos archivos.
ENVIRONMENT=production
POSTGRES_DB=calidad360
POSTGRES_USER=calidad360
POSTGRES_PASSWORD=reemplace_por_la_clave_del_usuario_postgresql
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# DATABASE_URL, si se define, prevalece sobre todas las variables POSTGRES_*.
# DATABASE_URL=postgresql+psycopg://usuario:clave_codificada@127.0.0.1:5432/calidad360
SECRET_KEY=reemplace_por_una_clave_aleatoria_de_64_caracteres
INITIAL_PASSWORD=reemplace_por_una_clave_de_acceso_segura
SEED_DEMO_DATA=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ACCESS_TOKEN_MINUTES=480
RETENTION_YEARS=3
BACKUP_DIR=./backups
# Se puede indicar la ruta completa si pg_dump no está en PATH.
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
